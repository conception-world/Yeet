# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node / TypeScript
node_modules/
out/
*.tsbuildinfo

# Rojo / plugin builds
build/
*.rbxm
*.rbxmx
*.rbxl
*.rbxlx

# VS Code extension packaging
*.vsix
.vscode-test/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
.vs/
*.swp
*.swo

# Yeet runtime state — auth tokens, pairing breadcrumbs.
# Created per-project when the daemon runs; never commit secrets.
.yeet/

# Regenerated by the daemon on every structural change (each file added,
# removed, or renamed rewrites it), so committing it produces churn and
# merge conflicts for a file no human edits. Matches the .gitignore that
# `Yeet: Create` scaffolds into new projects (see create.ts writeGitignore).
sourcemap.json

# Logs
*.log

# VitePress build output (docs-site/.gitignore also covers this,
# duplicated here so a fresh clone with no docs-site/.gitignore yet
# still ignores the build dir if `npm run docs:build` runs first)
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/
